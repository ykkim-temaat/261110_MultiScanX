<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. 파스텔 라이트 컬러 팔레트 (Light & Pastel Laboratory Theme) -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#F4F7FB"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE4F0"/>
    <SolidColorBrush x:Key="SubPanelBgBrush" Color="#F8FAFC"/>

    <!-- 파스텔 포인트 배경 -->
    <SolidColorBrush x:Key="PastelBlueBg" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="PastelBlueBorder" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="PastelBlueAccent" Color="#2563EB"/>

    <SolidColorBrush x:Key="PastelMintBg" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="PastelMintBorder" Color="#A7F3D0"/>
    <SolidColorBrush x:Key="PastelMintAccent" Color="#059669"/>

    <SolidColorBrush x:Key="PastelLavenderBg" Color="#F5F3FF"/>
    <SolidColorBrush x:Key="PastelLavenderBorder" Color="#DDD6FE"/>
    <SolidColorBrush x:Key="PastelLavenderAccent" Color="#7C3AED"/>

    <SolidColorBrush x:Key="PastelAmberBg" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="PastelAmberBorder" Color="#FDE68A"/>
    <SolidColorBrush x:Key="PastelAmberAccent" Color="#D97706"/>

    <SolidColorBrush x:Key="PastelCoralBg" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="PastelCoralBorder" Color="#FECACA"/>
    <SolidColorBrush x:Key="PastelCoralAccent" Color="#DC2626"/>

    <!-- 텍스트 브러시 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <!-- 2. 공통 카드 컨테이너 스타일 -->
    <Style x:Key="PastelCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#94A3B8" BlurRadius="10" ShadowDepth="2" Opacity="0.10"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 3. 파스텔 버튼 스타일 -->
    <Style x:Key="PrimaryPastelButton" TargetType="Button">
        <Setter Property="Background" Value="#3B82F6"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#2563EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SoftActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryPastelButton}">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="Foreground" Value="#1D4ED8"/>
        <Setter Property="BorderBrush" Value="#BFDBFE"/>
    </Style>

    <Style x:Key="MintActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryPastelButton}">
        <Setter Property="Background" Value="#10B981"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#059669"/>
    </Style>

    <Style x:Key="CoralActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryPastelButton}">
        <Setter Property="Background" Value="#EF4444"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#DC2626"/>
    </Style>

    <Style x:Key="AmberActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryPastelButton}">
        <Setter Property="Background" Value="#FFFBEB"/>
        <Setter Property="Foreground" Value="#B45309"/>
        <Setter Property="BorderBrush" Value="#FCD34D"/>
    </Style>

    <Style x:Key="LavenderActionButton" TargetType="Button" BasedOn="{StaticResource PrimaryPastelButton}">
        <Setter Property="Background" Value="#F5F3FF"/>
        <Setter Property="Foreground" Value="#6D28D9"/>
        <Setter Property="BorderBrush" Value="#DDD6FE"/>
    </Style>

    <!-- 4. 섹션 타이틀 스타일 -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- 5. 입력 TextBox 스타일 -->
    <Style x:Key="PastelTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 6. DataGrid 파스텔 라이트 스타일 -->
    <Style x:Key="PastelDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
        <Setter Property="VerticalGridLinesBrush" Value="#F1F5F9"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="ColumnHeaderHeight" Value="32"/>
    </Style>

    <!-- 7. 서브탭 TabItem 파스텔 라이트 스타일 -->
    <Style x:Key="PastelTabItemStyle" TargetType="TabItem">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#334155"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

</ResourceDictionary>

