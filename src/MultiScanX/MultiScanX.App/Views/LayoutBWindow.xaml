<Window x:Class="MultiScanX.App.Views.LayoutBWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MultiScanX.App.ViewModels"
        xmlns:panels="clr-namespace:MultiScanX.App.Views.Panels"
        mc:Ignorable="d"
        Title="[GUI 초안 B - 좌측 사이드바 + 중앙 2D 맵 상시 고정 도킹형] MultiScan-X Studio (2560×1440 QHD Ready)"
        Width="1920" Height="1080" MaxWidth="2560" MaxHeight="1440"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBgBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단 슬림 헤더 & 해상도/레이아웃 비교 바 -->
            <RowDefinition Height="*"/>
            <!-- 메인 3단 도킹 레이아웃 (좌: 사이드바 / 중: 상시 고정 2D 맵 / 우: 가변 도킹 패널) -->
            <RowDefinition Height="Auto"/>
            <!-- 하단 상태 표시줄 -->
        </Grid.RowDefinitions>

        <!-- 1. 상단 헤더 바 -->
        <Border Grid.Row="0" Style="{StaticResource PastelCardStyle}" Padding="14,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#059669" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="GUI TYPE B : 좌측 내비게이션 + 중앙 2D 맵 상시 고정 도킹형" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding AppTitleHeader}" FontSize="17" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    <TextBlock Text=" | 2D 스테이지 맵을 항상 보면서 레시피 Shift 및 I/O·JOG를 동시 수행" FontSize="13" Foreground="#047857" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="해상도:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                    <Button Content="2560×1440 (QHD)" Style="{StaticResource SoftActionButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnResQhd_Click"/>
                    <Button Content="1920×1080 (FHD)" Style="{StaticResource SoftActionButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnResFhd_Click"/>
                    <Button Content="최대화" Style="{StaticResource SoftActionButton}" Padding="8,4" Margin="0,0,12,0" Click="BtnMaximize_Click"/>

                    <TextBlock Text="레이아웃 비교:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                    <Button Content="초안 A (상단리본형) 열기" Style="{StaticResource SoftActionButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnOpenLayoutA_Click"/>
                    <Button Content="초안 C (플로팅스튜디오형) 열기" Style="{StaticResource AmberActionButton}" Padding="8,4" Margin="0,0,10,0" Click="BtnOpenLayoutC_Click"/>

                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <TextBlock Text="🛡 DI01 EMO: 정상 (Safety ON)" Foreground="#15803D" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. 메인 3단 도킹 그리드 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="265"/>
                <!-- Col 0: 좌측 사이드 내비게이션 & 운전모드 & 3축/로드셀 요약 도킹 바 -->
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="590"/>
                <!-- Col 2: 상시 고정(Always-Visible) 2D 스테이지 맵 + 상단 시료 로딩 3단계 버튼 -->
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <!-- Col 4: 우측 가변 도킹 워크스페이스 -->
            </Grid.ColumnDefinitions>

            <!-- Col 0: 좌측 사이드 내비게이션 -->
            <Border Grid.Column="0" Style="{StaticResource PastelCardStyle}" Padding="12">
                <DockPanel>
                    <!-- 상단: 운전 모드 선택 및 우측 도킹 뷰 전환 메뉴 -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="🧭 운전 모드 선택 (Mode 0~5)" FontSize="12.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding OperationModes}" SelectedIndex="{Binding SelectedOperationModeIndex}" Height="32" FontSize="11.5" FontWeight="SemiBold" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                        <TextBlock Text="📂 우측 도킹 워크스페이스 전환" FontSize="12.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Button Content="📊 1. 실시간 결과 &amp; 식각(ΔH) 비교" Height="40" Margin="0,0,0,6" Style="{StaticResource PrimaryPastelButton}" HorizontalContentAlignment="Left" Click="BtnNav_Click" Tag="0"/>
                        <Button Content="📐 2. 10×10 레시피 편집 &amp; 행/열 Shift" Height="40" Margin="0,0,0,6" Style="{StaticResource SoftActionButton}" HorizontalContentAlignment="Left" Click="BtnNav_Click" Tag="1"/>
                        <Button Content="🛠 3. H/W &amp; I/O Check (CNT2/CI600A)" Height="40" Margin="0,0,0,6" Style="{StaticResource SoftActionButton}" HorizontalContentAlignment="Left" Click="BtnNav_Click" Tag="2"/>
                        <Button Content="⚙ 4. 센서 3D 오프셋 &amp; 시스템 설정" Height="40" Margin="0,0,0,14" Style="{StaticResource SoftActionButton}" HorizontalContentAlignment="Left" Click="BtnNav_Click" Tag="3"/>

                        <Separator Margin="0,0,0,12"/>

                        <!-- 실시간 하드웨어 텔레메트리 요약 카드 -->
                        <TextBlock Text="📡 실시간 하드웨어 텔레메트리" FontSize="12.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="X (Gantry):" Foreground="#64748B" FontSize="11.5"/>
                                    <TextBlock Text="{Binding CurrXFormatted, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Y (Chuck):" Foreground="#64748B" FontSize="11.5"/>
                                    <TextBlock Text="{Binding CurrYFormatted, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#047857"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Z (CNT2 50nm):" Foreground="#64748B" FontSize="11.5"/>
                                    <TextBlock Text="{Binding CurrZFormatted, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#6D28D9"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="CI-600A 하중:" Foreground="#64748B" FontSize="11.5"/>
                                    <TextBlock Text="{Binding NetWeightGram, StringFormat='{}{0:F1} g'}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#DC2626"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{Binding VacuumBadgeBg}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding VacuumStatusText}" Foreground="{Binding VacuumBadgeFg}" FontWeight="Bold" FontSize="11.5" TextWrapping="Wrap"/>
                        </Border>
                        <Border Background="{Binding LoadCellBadgeBg}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,6">
                            <TextBlock Text="{Binding LoadCellStatusText}" Foreground="{Binding LoadCellBadgeFg}" FontWeight="Bold" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8" VerticalAlignment="Bottom">
                        <TextBlock Text="💡 초안 B 장점: 우측에서 레시피 행/열을 이동하거나 I/O·JOG를 조작할 때 중앙 2D 맵이 가려지지 않고 실시간 연동됩니다."
                                   FontSize="11" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Col 2: 중앙 상시 고정(Always-Visible) 2D 스테이지 맵 + 상단 시료 로딩 3단계 워크플로우 바 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 상단 고정: 시료 로딩 3단계 워크플로우 나란히 배치 -->
                <Border Grid.Row="0" Style="{StaticResource PastelCardStyle}" Padding="10,8" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🚀 시료 로딩 &amp; 자동 계측 3단계 워크플로우 (상시 노출)" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <UniformGrid Columns="4">
                            <Button Content="① 측정준비(원점)" Height="36" Margin="0,0,4,0" Style="{StaticResource SoftActionButton}" FontSize="11.5" Click="BtnStep1Prepare_Click"/>
                            <Button Content="{Binding VacuumButtonText}" Height="36" Margin="2,0,4,0" Style="{StaticResource AmberActionButton}" FontSize="11" Click="BtnStep2Vacuum_Click"/>
                            <Button Content="③ ▶ 측정시작" Height="36" Margin="2,0,4,0" Style="{StaticResource MintActionButton}" FontSize="12" Click="BtnStep3Start_Click"/>
                            <Button Content="■ 측정중지" Height="36" Margin="2,0,0,0" Style="{StaticResource CoralActionButton}" FontSize="12" Click="BtnStop_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 중앙 고정: 510x515mm 2D 스테이지 맵 -->
                <panels:StageMapControl Grid.Row="1"/>
            </Grid>

            <!-- Col 4: 우측 가변 도킹 워크스페이스 (헤더 숨김 TabControl로 부드럽게 전환) -->
            <TabControl x:Name="RightDockTabs" Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem>
                    <panels:EtchComparisonControl/>
                </TabItem>
                <TabItem>
                    <panels:RecipeEditorControl/>
                </TabItem>
                <TabItem>
                    <panels:IoHardwareCheckControl/>
                </TabItem>
                <TabItem>
                    <panels:SystemConfigControl/>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 3. 하단 상태 표시줄 -->
        <Border Grid.Row="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#065F46" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RecipeSummaryText}" Foreground="#047857" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Width="260" Height="16" Foreground="#10B981" Background="#D1FAE5"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

