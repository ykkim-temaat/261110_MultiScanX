<UserControl x:Class="MultiScanX.App.Views.Panels.SystemConfigControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200" d:DesignHeight="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- 상단: 비밀번호 잠금 보호 배너 -->
            <Border Style="{StaticResource PastelCardStyle}" Margin="0,0,0,10" Background="#F8FAFC">
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="🔐 엔지니어 파라미터 보호 &amp; 시스템 설정 (C:\MultiScanX\config\system_config.json)"
                                   FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="핵심 오프셋, Z축 접촉 정지 우선순위, CI-600A 통신 및 F20 Calibration 좌표는 비밀번호(기본: 0000) 해제 후 저장할 수 있습니다."
                                   FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="비밀번호:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                        <PasswordBox x:Name="PwdBox" Width="90" Password="0000" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="{Binding AdminLockButtonText}" Background="{Binding AdminLockBadgeBg}" Foreground="{Binding AdminLockBadgeFg}"
                                BorderBrush="#CBD5E1" BorderThickness="1" Padding="12,6" FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0"
                                Click="BtnToggleUnlock_Click"/>
                        <Button Content="💾 전체 설정 저장" Style="{StaticResource MintActionButton}" Margin="8,0,0,0" Click="BtnSaveConfig_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <UniformGrid Columns="2">
                <!-- 1. 3종 센서 3D 기구 오프셋 (ΔX, ΔY, ΔZ) -->
                <Border Style="{StaticResource PastelCardStyle}" Margin="0,0,6,10">
                    <StackPanel>
                        <TextBlock Text="📏 3종 센서 3D 기구 오프셋 설정 (CL-3000 레이저 기준 상대거리)" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="동일 측정 포인트(X, Y, Z)를 복수 센서로 측정할 때 센서 간 물리적 장착 간격(ΔX, ΔY, ΔZ)을 자동 보상합니다."
                                   FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <!-- CL-3000 -->
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="① Keyence CL-3000 (공초점 레이저 변위 센서 — 기준 원점 Sensor)" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="ΔX (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.Cl3000Offset.OffsetX}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="3,0,3,0">
                                        <TextBlock Text="ΔY (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.Cl3000Offset.OffsetY}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="ΔZ (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.Cl3000Offset.OffsetZ}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- MMS PC2 -->
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="② Fischer MMS PC2 (와전류 Thick Cu 두께 접촉 프로브)" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="ΔX (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.MmsPc2Offset.OffsetX}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="3,0,3,0">
                                        <TextBlock Text="ΔY (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.MmsPc2Offset.OffsetY}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="ΔZ (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.MmsPc2Offset.OffsetZ}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- F20-EXR -->
                        <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel>
                                <TextBlock Text="③ Filmetrics F20-EXR (광학 분광 투과막 두께 프로브)" FontWeight="Bold" Foreground="#6D28D9" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="ΔX (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.F20ExrOffset.OffsetX}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="3,0,3,0">
                                        <TextBlock Text="ΔY (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.F20ExrOffset.OffsetY}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="ΔZ (mm)" FontSize="11" Foreground="#475569"/>
                                        <TextBox Text="{Binding CurrentConfig.F20ExrOffset.OffsetZ}" Style="{StaticResource PastelTextBoxStyle}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Z축 접촉 정지 다중 조건 우선순위 & F20 Zero Calibration 지그 좌표 -->
                <Border Style="{StaticResource PastelCardStyle}" Margin="6,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🛑 Z축 소프트 랜딩 다중 조건 정지 우선순위 (Multi-Source Stop)" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Z축 하강 시 아래 우선순위 조건 중 가장 먼저 도달하는 신호에 의해 즉시 정지하며, 과부하(DI5 / 30g) 감지 시 즉시 비상 상승합니다."
                                   FontSize="11" Foreground="#64748B" Margin="0,0,0,10" TextWrapping="Wrap"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                                <RowDefinition Height="34"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="🥇 1순위 정지 조건:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1D4ED8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CurrentConfig.ZStopPrimarySource}" Style="{StaticResource PastelTextBoxStyle}" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="🥈 2순위 정지 조건:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#047857"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CurrentConfig.ZStopSecondarySource}" Style="{StaticResource PastelTextBoxStyle}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="🥉 3순위 정지 조건:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6D28D9"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CurrentConfig.ZStopTertiarySource}" Style="{StaticResource PastelTextBoxStyle}" Margin="0,3"/>
                        </Grid>

                        <Separator Margin="0,0,0,10"/>

                        <TextBlock Text="🔆 Filmetrics F20-EXR Reference Si Wafer Zero Calibration 설정" Style="{StaticResource SectionTitleStyle}"/>
                        <UniformGrid Columns="3" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Cal 지그 X (mm)" FontSize="11" Foreground="#475569"/>
                                <TextBox Text="{Binding CurrentConfig.F20CalStageX}" Style="{StaticResource PastelTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="3,0,3,0">
                                <TextBlock Text="Cal 지그 Y (mm)" FontSize="11" Foreground="#475569"/>
                                <TextBox Text="{Binding CurrentConfig.F20CalStageY}" Style="{StaticResource PastelTextBoxStyle}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Cal 지그 Z (mm)" FontSize="11" Foreground="#475569"/>
                                <TextBox Text="{Binding CurrentConfig.F20CalStageZ}" Style="{StaticResource PastelTextBoxStyle}"/>
                            </StackPanel>
                        </UniformGrid>
                        <DockPanel>
                            <CheckBox Content="레시피 자동 측정(Mode 4) 시작 전 항상 F20 Zero Calibration 자동 수행"
                                      IsChecked="{Binding CurrentConfig.F20AutoCalBeforeRecipe}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button DockPanel.Dock="Right" Content="🔆 지금 수동 Zero Cal 실행" Style="{StaticResource LavenderActionButton}" HorizontalAlignment="Right" Click="BtnExecF20Cal_Click"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 하단: CAS CI-600A RS-232C / Modbus-RTU 및 네트워크 통신 설정 -->
            <Border Style="{StaticResource PastelCardStyle}">
                <StackPanel>
                    <TextBlock Text="🔌 CAS CI-600A 로드셀 인디케이터 (07-2_141116_CI600A_KOR_UM.pdf) 및 통신 설정" Style="{StaticResource SectionTitleStyle}"/>
                    <UniformGrid Columns="5">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="CI-600A 포트 (COM1: Pin 2/3/5)" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding CurrentConfig.LoadCellComPort}" Style="{StaticResource PastelTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Text="Baud Rate (Menu-2204)" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding CurrentConfig.LoadCellBaudRate}" Style="{StaticResource PastelTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Text="Slave ID (Menu-2201)" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding CurrentConfig.LoadCellSlaveId}" Style="{StaticResource PastelTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,8,0">
                            <TextBlock Text="통신 프로토콜 (Menu-2207)" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding CurrentConfig.LoadCellProtocol}" Style="{StaticResource PastelTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Keyence CL-3000 TCP IP:Port" FontSize="11" Foreground="#475569"/>
                            <TextBox Text="{Binding CurrentConfig.KeyenceIp}" Style="{StaticResource PastelTextBoxStyle}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
