<UserControl x:Class="MultiScanX.App.Views.Panels.EtchComparisonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 상단: 3종 센서 & CL-3000 식각 전/후 핵심 통계 요약 카드 -->
            <RowDefinition Height="*"/>
            <!-- 중앙: 측정 결과 & CL-3000 식각 전(Pre)/후(Post) ΔH 데이터 그리드 -->
            <RowDefinition Height="170"/>
            <!-- 하단: 실시간 시스템 동작 로그 -->
        </Grid.RowDefinitions>

        <!-- 상단 4열 요약 카드 -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,10">
            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="🟢 Fischer MMS PC2 (Cu 두께)" FontSize="11.5" FontWeight="Bold" Foreground="#047857"/>
                    <TextBlock Text="{Binding LiveMmsCuUm, StringFormat='{}{0:F3} μm'}" FontSize="22" FontWeight="Bold" Foreground="#065F46" Margin="0,2"/>
                    <TextBlock Text="{Binding StatCuAvg, StringFormat='Lot 평균: {0:F3} μm'}" FontSize="11" Foreground="#047857"/>
                </StackPanel>
            </Border>

            <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="🟣 Filmetrics F20-EXR (광학박막)" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9"/>
                    <TextBlock Text="{Binding LiveF20FilmNm, StringFormat='{}{0:F1} nm'}" FontSize="22" FontWeight="Bold" Foreground="#5B21B6" Margin="0,2"/>
                    <TextBlock Text="{Binding LiveF20Gof, StringFormat='GOF 적합도: {0:F3} (Pass >= 0.90)'}" FontSize="11" Foreground="#6D28D9"/>
                </StackPanel>
            </Border>

            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="🔵 Keyence CL-3000 (식각량 ΔH)" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8"/>
                    <TextBlock Text="{Binding StatEtchDepthAvg, StringFormat='{}{0:F2} μm'}" FontSize="22" FontWeight="Bold" Foreground="#1E40AF" Margin="0,2"/>
                    <TextBlock Text="ΔH = Pre-Etch − Post-Etch" FontSize="11" Foreground="#1D4ED8"/>
                </StackPanel>
            </Border>

            <Border Background="{Binding LoadCellBadgeBg}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="⚖ CAS CI-600A 접촉 하중" FontSize="11.5" FontWeight="Bold" Foreground="{Binding LoadCellBadgeFg}"/>
                    <TextBlock Text="{Binding NetWeightGram, StringFormat='{}{0:F1} g'}" FontSize="22" FontWeight="Bold" Foreground="{Binding LoadCellBadgeFg}" Margin="0,2"/>
                    <TextBlock Text="{Binding LoadCellStatusText}" FontSize="10.5" Foreground="{Binding LoadCellBadgeFg}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 중앙: 실시간 계측 & CL-3000 식각 전/후 비교 DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource PastelCardStyle}" Margin="0,0,0,10">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="📊 다중 센서 통합 계측 데이터 &amp; CL-3000 식각(연마) 전/후 단차(ΔH) 비교 테이블"
                               FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding F20CalStatusText}" FontSize="11.5" FontWeight="SemiBold" Foreground="#6D28D9" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>

                <DataGrid ItemsSource="{Binding MeasuredPoints}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource PastelDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pt" Binding="{Binding PointId}" Width="42"/>
                        <DataGridTextColumn Header="Grid" Binding="{Binding GridLabel}" Width="58"/>
                        <DataGridTextColumn Header="X (mm)" Binding="{Binding TargetX, StringFormat=F1}" Width="65"/>
                        <DataGridTextColumn Header="Y (mm)" Binding="{Binding TargetY, StringFormat=F1}" Width="65"/>
                        <DataGridTextColumn Header="CNT2 Z (mm)" Binding="{Binding ActualZ, StringFormat=F3}" Width="88"/>
                        <DataGridTextColumn Header="PC2 Cu (μm)" Binding="{Binding CuThicknessUm, StringFormat=F3}" Width="88"/>
                        <DataGridTextColumn Header="F20 Film (nm)" Binding="{Binding FilmThicknessNm, StringFormat=F1}" Width="92"/>
                        <DataGridTextColumn Header="GOF" Binding="{Binding FilmGoodnessOfFit, StringFormat=F3}" Width="58"/>
                        <DataGridTextColumn Header="CL3000 식각전(μm)" Binding="{Binding PreEtchHeightUm, StringFormat=F2}" Width="115"/>
                        <DataGridTextColumn Header="CL3000 식각후(μm)" Binding="{Binding PostEtchHeightUm, StringFormat=F2}" Width="115"/>
                        <DataGridTextColumn Header="식각량 ΔH(μm)" Binding="{Binding EtchDepthDeltaUm, StringFormat=F2}" Width="95"/>
                        <DataGridTextColumn Header="하중(g)" Binding="{Binding ContactLoadG, StringFormat=F1}" Width="62"/>
                        <DataGridTextColumn Header="정지트리거" Binding="{Binding StopTriggerSource}" Width="95"/>
                        <DataGridTextColumn Header="판정" Binding="{Binding Note}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- 하단: 실시간 시스템 이벤트 로그 -->
        <Border Grid.Row="2" Style="{StaticResource PastelCardStyle}" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="📜 실시간 시퀀스 &amp; 하드웨어 인터록 로그 (최신순)" FontSize="12.5" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding LogMessages}" Background="#F8FAFC" Foreground="#1E293B" BorderBrush="#E2E8F0" BorderThickness="1" FontFamily="Consolas" FontSize="11.5"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

