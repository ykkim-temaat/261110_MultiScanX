<UserControl x:Class="MultiScanX.App.Views.Panels.IoHardwareCheckControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1500" d:DesignHeight="880">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="465"/>
            <!-- Left: 3축 JOG / CNT2 요약 / CI-600A 로드셀 / EtherCAT Slaves -->
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
            <!-- Right: 아진엑스텍 3대 슬레이브 통합 관제 (탭1: DB32T DIO / 탭2: AI16 16CH / 탭3: CNT2 Low-Level) -->
        </Grid.ColumnDefinitions>

        <!-- 좌측: 3축 JOG & CNT2 리니어스케일 & CAS CI-600A 로드셀 & EtherCAT 슬레이브 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 3축 모션 수동 JOG & CNT2 Renishaw 50nm 리니어스케일 -->
                <Border Style="{StaticResource PastelCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🕹 3축 서보/스텝 수동 JOG &amp; CNT2 (Renishaw 50nm) 점검" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="X축 (Panasonic 400W 갠트리):" Foreground="#475569" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrXFormatted, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Y축 (Panasonic 400W 포러스척):" Foreground="#475569" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrYFormatted, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#047857"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Z축 (FASTECH Full-Closed + Brake):" Foreground="#475569" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CurrZFormatted, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#6D28D9"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="CNT2 CH1 (Renishaw 50nm Scale):" Foreground="#475569" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Cnt2ScaleFormatted, Mode=OneWay}" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#7C3AED"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- XY JOG Step & Buttons -->
                        <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                            <TextBlock Text="XY Step(mm):" VerticalAlignment="Center" Width="85" FontWeight="SemiBold" Foreground="#334155"/>
                            <Button Content="0.1" Width="46" Margin="0,0,4,0" Style="{StaticResource SoftActionButton}" Click="BtnStepXY_Click" Tag="0.1"/>
                            <Button Content="1.0" Width="46" Margin="0,0,4,0" Style="{StaticResource SoftActionButton}" Click="BtnStepXY_Click" Tag="1.0"/>
                            <Button Content="10.0" Width="52" Margin="0,0,4,0" Style="{StaticResource SoftActionButton}" Click="BtnStepXY_Click" Tag="10.0"/>
                            <Button Content="50.0" Width="52" Margin="0,0,8,0" Style="{StaticResource SoftActionButton}" Click="BtnStepXY_Click" Tag="50.0"/>
                            <TextBlock Text="{Binding JogStepXY, StringFormat='현재: {0:F1}mm'}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="Z Step(mm):" VerticalAlignment="Center" Width="85" FontWeight="SemiBold" Foreground="#334155"/>
                            <Button Content="0.001" Width="52" Margin="0,0,4,0" Style="{StaticResource LavenderActionButton}" Click="BtnStepZ_Click" Tag="0.001"/>
                            <Button Content="0.010" Width="52" Margin="0,0,4,0" Style="{StaticResource LavenderActionButton}" Click="BtnStepZ_Click" Tag="0.010"/>
                            <Button Content="0.100" Width="52" Margin="0,0,4,0" Style="{StaticResource LavenderActionButton}" Click="BtnStepZ_Click" Tag="0.100"/>
                            <Button Content="1.000" Width="52" Margin="0,0,8,0" Style="{StaticResource LavenderActionButton}" Click="BtnStepZ_Click" Tag="1.000"/>
                            <TextBlock Text="{Binding JogStepZ, StringFormat='현재: {0:F3}mm'}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#6D28D9"/>
                        </WrapPanel>

                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,6">
                            <Button Content="◀ X - (Left)" Margin="2" Height="32" Style="{StaticResource SoftActionButton}" Click="BtnJog_Click" Tag="X:-1"/>
                            <Button Content="▲ Y - (Rear)" Margin="2" Height="32" Style="{StaticResource SoftActionButton}" Click="BtnJog_Click" Tag="Y:-1"/>
                            <Button Content="🔼 Z - (Up 상승)" Margin="2" Height="32" Style="{StaticResource LavenderActionButton}" Click="BtnJog_Click" Tag="Z:-1"/>
                            <Button Content="▶ X + (Right)" Margin="2" Height="32" Style="{StaticResource SoftActionButton}" Click="BtnJog_Click" Tag="X:1"/>
                            <Button Content="▼ Y + (Front)" Margin="2" Height="32" Style="{StaticResource SoftActionButton}" Click="BtnJog_Click" Tag="Y:1"/>
                            <Button Content="🔽 Z + (Down 하강)" Margin="2" Height="32" Style="{StaticResource LavenderActionButton}" Click="BtnJog_Click" Tag="Z:1"/>
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Button Content="🏠 전 축 HOME" Margin="2" Height="32" Style="{StaticResource MintActionButton}" Click="BtnHomeAll_Click"/>
                            <Button Content="🎯 Z-Scale 0점 리셋" Margin="2" Height="32" Style="{StaticResource LavenderActionButton}" Click="BtnCnt2ZeroClear_Click"/>
                            <Button Content="{Binding ZBrakeStatusText}" Margin="2" Height="32" Style="{StaticResource AmberActionButton}" Click="BtnToggleBrake_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 2. CAS CI-600A 로드셀 인디케이터 (07-2_141116_CI600A_KOR_UM.pdf 사양 반영) -->
                <Border Style="{StaticResource PastelCardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="⚖ CAS CI-600A 로드셀 (RS-232C Modbus-RTU &amp; Relay)" FontSize="14" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border Background="{Binding LoadCellBadgeBg}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding LoadCellStatusText}" Foreground="{Binding LoadCellBadgeFg}" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DockPanel>

                        <TextBlock Text="매뉴얼(CI600A_KOR_UM p.56~73): COM1(9600, 8-N-1), Menu-2207=9(MODBUS-RTU), CN2 Relay OUT1->DI4 / OUT2->DI5"
                                   FontSize="10.5" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <!-- Modbus 레지스터 실시간 상태 -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                            <UniformGrid Columns="2" Rows="2">
                                <TextBlock Text="{Binding Ci600ModbusGrossReg}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="2"/>
                                <TextBlock Text="{Binding Ci600ModbusNetReg}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8" Margin="2"/>
                                <TextBlock Text="{Binding Ci600ModbusAdcReg}" FontSize="11.5" Foreground="#475569" Margin="2"/>
                                <TextBlock Text="{Binding Ci600ModbusSpReg}" FontSize="11.5" FontWeight="SemiBold" Foreground="#047857" Margin="2"/>
                            </UniformGrid>
                        </Border>

                        <!-- 하중 시뮬레이션 슬라이더 -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="하중 인가 테스트(g):" Width="115" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentLoadGram, StringFormat='{}{0:F1} g'}" Width="55" TextAlignment="Right" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="45" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding CurrentLoadGram, Mode=TwoWay}" VerticalAlignment="Center"/>
                        </DockPanel>

                        <!-- SP1 / SP2 설정 및 영점/용기 명령 버튼 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SP1 목표(DI4):" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11.5"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentConfig.LoadCellSetPoint1Gram, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PastelTextBoxStyle}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="SP2 상한(DI5):" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11.5"/>
                            <TextBox Grid.Column="3" Text="{Binding CurrentConfig.LoadCellLimitGram, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PastelTextBoxStyle}"/>
                        </Grid>

                        <UniformGrid Columns="3">
                            <Button Content="0.0g 영점 (01MZ)" Margin="2" Height="30" Style="{StaticResource SoftActionButton}" Click="BtnLoadCellZero_Click"/>
                            <Button Content="용기 차감 (01MT)" Margin="2" Height="30" Style="{StaticResource SoftActionButton}" Click="BtnLoadCellTare_Click"/>
                            <Button Content="SP1/SP2 전송(0x10)" Margin="2" Height="30" Style="{StaticResource PrimaryPastelButton}" Click="BtnLoadCellApplySp_Click"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- 3. EtherCAT 7개 슬레이브 연결 상태 -->
                <Border Style="{StaticResource PastelCardStyle}">
                    <StackPanel>
                        <TextBlock Text="🔗 EtherCAT 마스터(PCIe-R0805) 7개 슬레이브 상태" Style="{StaticResource SectionTitleStyle}"/>
                        <DataGrid ItemsSource="{Binding EtherCatSlaves}" AutoGenerateColumns="False" IsReadOnly="True"
                                  Style="{StaticResource PastelDataGridStyle}" Height="210">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding NodeId}" Width="35"/>
                                <DataGridTextColumn Header="DIP" Binding="{Binding DipSwitchHex}" Width="45"/>
                                <DataGridTextColumn Header="모델명" Binding="{Binding VendorAndModel}" Width="155"/>
                                <DataGridTextColumn Header="역할" Binding="{Binding RoleDescription}" Width="*"/>
                                <DataGridTextColumn Header="상태" Binding="{Binding AlState}" Width="65"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 우측: 아진엑스텍 3종 EtherCAT 슬레이브 통합 관제 (탭1: DB32T DIO / 탭2: AI16 16CH / 탭3: CNT2 Low-Level) -->
        <Border Grid.Column="2" Style="{StaticResource PastelCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 상단 공통 헤더: 실물 AXL 온라인 상태 배지 & 재연결/저장 버튼 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠 아진엑스텍 EtherCAT 슬레이브 실시간 점검 &amp; Low-Level 설정" FontSize="14.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border Background="{Binding AxlConnectionBadgeBg}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                <TextBlock Text="{Binding AxlConnectionBadgeText}" Foreground="{Binding AxlConnectionBadgeFg}" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="50ms(20Hz) 주기로 DB32T(16DI/16DO), AI16(16CH 전압/전류), CNT2(2CH 카운터/트리거)를 실시간 폴링합니다."
                                   FontSize="11" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="{Binding IoLockButtonText}" Background="{Binding AdminLockBadgeBg}" Foreground="{Binding AdminLockBadgeFg}"
                                BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="11.5" Padding="10,5" Margin="0,0,6,0" Cursor="Hand"
                                Click="BtnToggleIoLock_Click"/>
                        <Button Content="🔌 AXL 실물 재연결/스캔" Style="{StaticResource SoftActionButton}" Margin="0,0,6,0" Click="BtnReconnectAxl_Click"/>
                        <Button Content="💾 I/O·AI·CNT2 설정 저장" Style="{StaticResource MintActionButton}" Click="BtnSaveIoConfig_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- 3단 서브탭: [1] DB32T 디지털 I/O | [2] AI16 아날로그 입력 | [3] CNT2 고속 카운터 Low-Level -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <!-- ================================================================================= -->
                    <!-- [탭 1] N3ECAT-DB32T (Node 0x04) 16 DI / 16 DO 실시간 모니터 및 동적 명칭 편집        -->
                    <!-- ================================================================================= -->
                    <TabItem Header="📥📤 1. DB32T 디지털 I/O (16DI/16DO)" Style="{StaticResource PastelTabItemStyle}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- PDO Word Hex/Binary 상태 바 및 DO 순차 점멸 테스트 -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DiWordHexBinary}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5" Margin="0,0,18,0"/>
                                        <TextBlock Text="{Binding DoWordHexBinary}" FontWeight="Bold" Foreground="#047857" FontSize="11.5"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <CheckBox Content="DI 시뮬레이션 수동반전 허용" IsChecked="{Binding AllowDiSimulationOverride}" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                                        <Button Content="⚡ DO01~08 순차 점멸(Walking) 테스트" Style="{StaticResource LavenderActionButton}" Padding="8,3" FontSize="11" Click="BtnDoBlinkTest_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 좌: 16 DI 입력 채널 리스트 (TxPDO 0x1A00 -> 0x6000:00) -->
                                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="📥 Digital Input (DI01 ~ DI16, 0x6000) — 실물 센서 상태 모니터" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,6"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DiChannels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,0,2.5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="46"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="74"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         IsReadOnly="{Binding DataContext.IsIoEditLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         Style="{StaticResource PastelTextBoxStyle}" Padding="5,2" Margin="4,0,8,0"/>
                                                                <Button Grid.Column="2" Content="{Binding StateText}" Background="{Binding BadgeBg}" Foreground="{Binding BadgeFg}"
                                                                        BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="11" Padding="4,2" Cursor="Hand"
                                                                        Click="BtnToggleIoBit_Click" Tag="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>

                                <!-- 우: 16 DO 출력 채널 리스트 (RxPDO 0x1601 -> 0x7010:00) -->
                                <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="📤 Digital Output (DO01 ~ DO16, 0x7010) — 클릭 시 실물/시뮬 출력 토글" FontWeight="Bold" Foreground="#047857" Margin="0,0,0,6"/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding DoChannels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,0,2.5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="46"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="74"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                         IsReadOnly="{Binding DataContext.IsIoEditLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                         Style="{StaticResource PastelTextBoxStyle}" Padding="5,2" Margin="4,0,8,0"/>
                                                                <Button Grid.Column="2" Content="{Binding StateText}" Background="{Binding BadgeBg}" Foreground="{Binding BadgeFg}"
                                                                        BorderBrush="#CBD5E1" BorderThickness="1" FontWeight="Bold" FontSize="11" Padding="4,2" Cursor="Hand"
                                                                        Click="BtnToggleIoBit_Click" Tag="{Binding}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- ================================================================================= -->
                    <!-- [탭 2] N3ECAT-AI16 (Node 0x05) 16CH 아날로그 입력 정의, 스케일링 및 실시간 모니터링  -->
                    <!-- ================================================================================= -->
                    <TabItem Header="📈 2. AI16 아날로그 입력 (16CH)" Style="{StaticResource PastelTabItemStyle}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- AI16 하드웨어 사양 배너 (03-1_N3ECAT-AI16_AO8_Manual(K)_201504.pdf p.6, 13, 22) -->
                            <Border Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                                <TextBlock Text="📘 N3ECAT-AI16 매뉴얼(p.13, 22): 총 16채널 16-bit (4kHz) | CH1~CH4는 전면 DIP 스위치로 전압(OFF, 오른쪽)/전류(ON, 왼쪽 -20~+20mA) 선택 가능, CH5~CH16은 전압(-10~+10V) 전용 | 물리량 = Raw × Scale + Offset"
                                           FontSize="11.5" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap"/>
                            </Border>

                            <!-- 컬럼 헤더 -->
                            <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="185"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="115"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="채널" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
                                    <TextBlock Grid.Column="1" Text="H/W 특성" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
                                    <TextBlock Grid.Column="2" Text="센서/채널 명칭 (동적 편집)" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
                                    <TextBlock Grid.Column="3" Text="입력 모드/범위" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
                                    <TextBlock Grid.Column="4" Text="실시간 Raw 입력" FontWeight="Bold" FontSize="11.5" Foreground="#1D4ED8"/>
                                    <TextBlock Grid.Column="5" Text="Scale" FontWeight="Bold" FontSize="11.5" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="Offset" FontWeight="Bold" FontSize="11.5" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="단위" FontWeight="Bold" FontSize="11.5" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="8" Text="환산 물리량" FontWeight="Bold" FontSize="11.5" Foreground="#047857" TextAlignment="Right"/>
                                </Grid>
                            </Border>

                            <!-- 16채널 스크롤 리스트 -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AiChannels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,4">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="105"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="185"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="55"/>
                                                        <ColumnDefinition Width="115"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Code}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                                    <Grid Grid.Column="1" Margin="0,0,6,0">
                                                        <ComboBox ItemsSource="{Binding DataContext.AiDipSwitchOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding DipSwitchMode, Mode=TwoWay}"
                                                                  Visibility="{Binding SupportsCurrentDip, Converter={StaticResource BoolToVis}}"
                                                                  IsEnabled="{Binding DataContext.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  Height="26" FontSize="10.5"/>
                                                        <TextBlock Text="CH5~16 (V 전용)" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SupportsCurrentDip}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding DataContext.IsIoEditLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Style="{StaticResource PastelTextBoxStyle}" Margin="0,0,8,0"/>
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding DataContext.AiSignalModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding SignalMode, Mode=TwoWay}"
                                                              IsEnabled="{Binding DataContext.IsAdminUnlocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              Height="26" FontSize="11" Margin="0,0,8,0"/>

                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding RawFormatted}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5"/>
                                                        <ProgressBar Value="{Binding GaugePercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="#3B82F6" Background="#E2E8F0" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <TextBox Grid.Column="5" Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding DataContext.IsIoEditLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Style="{StaticResource PastelTextBoxStyle}" TextAlignment="Right" Margin="2,0"/>
                                                    <TextBox Grid.Column="6" Text="{Binding Offset, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding DataContext.IsIoEditLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Style="{StaticResource PastelTextBoxStyle}" TextAlignment="Right" Margin="2,0"/>
                                                    <TextBox Grid.Column="7" Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding DataContext.IsIoEditLocked, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             Style="{StaticResource PastelTextBoxStyle}" TextAlignment="Center" Margin="2,0"/>

                                                    <Border Grid.Column="8" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="5" Padding="6,3" Margin="4,0,0,0">
                                                        <TextBlock Text="{Binding ConvertedFormatted}" FontWeight="Bold" Foreground="#047857" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- ================================================================================= -->
                    <!-- [탭 3] N3ECAT-CNT2 (Node 0x03) Z축 리니어스케일 Low-Level 세팅 및 고속 위치 트리거  -->
                    <!-- ================================================================================= -->
                    <TabItem Header="📏 3. CNT2 고속 카운터 (Z-Scale)" Style="{StaticResource PastelTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <!-- 안내 배너 -->
                                <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                    <TextBlock Text="📘 N3ECAT-CNT2 매뉴얼(02-2_N3ECAT_Slave_SW_KOR_V1.1.pdf p.67~90, Product 0x00000902): Z축 구동은 FASTECH 서보가 담당하고, Renishaw 50nm 리니어스케일 피드백과 하드웨어 위치 트리거는 본 아진 CNT2 모듈이 전담합니다."
                                               FontSize="11.5" FontWeight="SemiBold" Foreground="#5B21B6" TextWrapping="Wrap"/>
                                </Border>

                                <!-- 섹션 1: CH1 / CH2 실시간 28-bit 카운터 & PDO 상태 모니터 -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="1. 듀얼 채널 실시간 28-bit 카운터 &amp; TxPDO (0x1A00) 상태 모니터" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,8"/>
                                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Cnt2Ch1DetailText}" FontSize="14" FontWeight="Bold" Foreground="#6D28D9" Margin="0,0,0,6"/>
                                                <TextBlock Text="{Binding Cnt2Ch2DetailText}" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569"/>
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="2">
                                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Cnt2PresetStatusText}" FontWeight="Bold" Foreground="#047857" FontSize="11.5"/>
                                            </Border>
                                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Cnt2TriggerStatusText}" FontWeight="Bold" Foreground="#1D4ED8" FontSize="11.5"/>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- 섹션 2: 원점 초기화(Zero Clear) 및 지정 위치 프리셋 (RxPDO 0x7000 & 0x7002) -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="2. Z축 리니어스케일 원점(0점) 설정 및 임의 기준위치 Preset (RxPDO 0x7000 &amp; 0x7002)" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                                        <TextBlock Text="JOG로 Z축 헤드를 기준 시편(또는 원점)에 접촉시킨 후 [0점 초기화]를 누르면 CNT2 카운터가 0 Pulse로 즉시 리셋됩니다."
                                                   FontSize="11" Foreground="#64748B" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Content="🎯 CH1 원점 0점 초기화 (0.0000 mm Zero Clear)" Height="36" Style="{StaticResource MintActionButton}" Click="BtnCnt2ZeroClear_Click"/>
                                            <TextBlock Grid.Column="2" Text="Preset 목표 위치(mm):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="3" Text="{Binding CurrentConfig.Cnt2PresetTargetMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PastelTextBoxStyle}" VerticalContentAlignment="Center" Height="32" Margin="0,0,8,0"/>
                                            <Button Grid.Column="4" Content="📌 지정 위치 Preset 강제 적용 (0x7000 Target -> 0x7002 Bit0 Rising)" Height="36" Style="{StaticResource LavenderActionButton}" Click="BtnCnt2ApplyPreset_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 섹션 3: 인코더 체배율(0x2001) 및 카운트 방향(0x2002) SDO Low-Level 설정 -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="3. 인코더 체배율 (SDO 0x2001) &amp; 카운트 방향 (SDO 0x2002) Low-Level 설정" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="135"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="입력 체배율 (0x2001):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Cnt2EncoderMethodOptions}" SelectedIndex="{Binding CurrentConfig.Cnt2EncoderMethodIndex}" Height="30" Margin="0,0,12,0"/>

                                            <TextBlock Grid.Column="2" Text="카운트 방향 (0x2002):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding Cnt2EncoderDirectionOptions}" SelectedIndex="{Binding CurrentConfig.Cnt2EncoderDirectionIndex}" Height="30" Margin="0,0,12,0"/>

                                            <TextBlock Grid.Column="4" Text="스케일 분해능(nm/cnt):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Grid.Column="5" Text="{Binding CurrentConfig.Cnt2ScaleResolutionNm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PastelTextBoxStyle}" Height="30" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <Button Content="⚙ CNT2 인코더 SDO 파라미터(체배율/방향/분해능) 하드웨어 적용" Height="34" Style="{StaticResource PrimaryPastelButton}" Click="BtnCnt2ApplyEncoder_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- 섹션 4: 고속 위치 비교 트리거 (RxPDO 0x7010 & SDO 0x2010~0x2012) -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="4. 고속 하드웨어 위치 비교 트리거 설정 &amp; 수동 발사 점검 (RxPDO 0x7010 &amp; SDO 0x2010~0x2012)" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="125"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="115"/>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="115"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="트리거 모드(0x2010):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Cnt2TriggerModeOptions}" SelectedIndex="{Binding CurrentConfig.Cnt2TriggerModeIndex}" Height="30" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="2" Text="출력 레벨(0x2011):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <ComboBox Grid.Column="3" ItemsSource="{Binding Cnt2TriggerLevelOptions}" SelectedIndex="{Binding CurrentConfig.Cnt2TriggerLevelIndex}" Height="30" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="4" Text="펄스 폭(0x2012 us):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Grid.Column="5" Text="{Binding CurrentConfig.Cnt2TriggerPulseWidthUs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PastelTextBoxStyle}" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                                            <TextBlock Grid.Column="6" Text="비교 목표위치(mm):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Grid.Column="7" Text="{Binding CurrentConfig.Cnt2TriggerComparePosMm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PastelTextBoxStyle}" Height="30" VerticalContentAlignment="Center"/>
                                        </Grid>

                                        <UniformGrid Columns="2">
                                            <Button Content="{Binding Cnt2TriggerButtonText}" Height="34" Style="{StaticResource LavenderActionButton}" Margin="0,0,6,0" Click="BtnCnt2ToggleTrigger_Click"/>
                                            <Button Content="🔥 1회 수동 트리거 발사 (One-Shot Trigger: 0x7010 Bit1)" Height="34" Style="{StaticResource AmberActionButton}" Margin="6,0,0,0" Click="BtnCnt2OneShot_Click"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
