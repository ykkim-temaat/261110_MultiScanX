<Window x:Class="MultiScanX.App.Views.LayoutAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MultiScanX.App.ViewModels"
        xmlns:panels="clr-namespace:MultiScanX.App.Views.Panels"
        mc:Ignorable="d"
        Title="[GUI 초안 A - 상단 리본 탭 표준형] MultiScan-X Studio (2560×1440 QHD Ready)"
        Width="1920" Height="1080" MaxWidth="2560" MaxHeight="1440"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource AppBgBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. 상단 타이틀 & 해상도/레이아웃 비교 전환 바 -->
            <RowDefinition Height="Auto"/>
            <!-- 2. 시료 로딩 3단계 워크플로우 & 운전 모드(Mode 0~5) 제어 바 -->
            <RowDefinition Height="*"/>
            <!-- 3. 상단 리본 탭 기반 메인 워크스페이스 -->
            <RowDefinition Height="Auto"/>
            <!-- 4. 하단 상태 표시줄 및 진행률 바 -->
        </Grid.RowDefinitions>

        <!-- 1. 상단 헤더 바 -->
        <Border Grid.Row="0" Style="{StaticResource PastelCardStyle}" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                        <TextBlock Text="GUI TYPE A : 상단 워크플로우 리본 탭 표준형" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <TextBlock Text="{Binding AppTitleHeader}" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    <TextBlock Text=" | K社(KCT向) 510×515mm 박막두께 통합 계측 제어기" FontSize="13.5" Foreground="#475569" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- 우측: 해상도 프리셋 & 다른 레이아웃 즉시 열기 + 인터록 배지 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="해상도 비교:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                    <Button Content="2560×1440 (QHD)" Style="{StaticResource SoftActionButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnResQhd_Click"/>
                    <Button Content="1920×1080 (FHD)" Style="{StaticResource SoftActionButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnResFhd_Click"/>
                    <Button Content="전체화면 최대화" Style="{StaticResource SoftActionButton}" Padding="8,4" Margin="0,0,12,0" Click="BtnMaximize_Click"/>

                    <TextBlock Text="다른 레이아웃 비교:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
                    <Button Content="초안 B (좌측도킹형) 열기" Style="{StaticResource LavenderActionButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnOpenLayoutB_Click"/>
                    <Button Content="초안 C (플로팅스튜디오형) 열기" Style="{StaticResource AmberActionButton}" Padding="8,4" Margin="0,0,12,0" Click="BtnOpenLayoutC_Click"/>

                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,6,0">
                        <TextBlock Text="🛡 DI01 EMO: 정상 (G9SE Safety ON)" Foreground="#15803D" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="10,4">
                        <TextBlock Text="{Binding OperationModeBadgeText}" Foreground="#1D4ED8" FontSize="11.5" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. 시료 로딩 3단계 워크플로우 & 운전 모드(Mode 0~5) 제어 바 -->
        <Border Grid.Row="1" Style="{StaticResource PastelCardStyle}" Padding="14,10" Margin="0,0,0,10" Background="#FFFFFF">
            <DockPanel>
                <!-- 좌측: 시료 로딩 3단계 나란히 배치 (① 측정준비 -> ② 진공펌프 ON/OFF -> ③ 측정시작 + 측정중지) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="시료 로딩 워크플로우:" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="① 측정준비 (원점복귀 / 진공OFF)" Height="38" Padding="14,0" Style="{StaticResource SoftActionButton}" Margin="0,0,6,0" Click="BtnStep1Prepare_Click"/>
                    <TextBlock Text="➔" VerticalAlignment="Center" Foreground="#94A3B8" FontWeight="Bold" Margin="0,0,6,0"/>
                    <Button Content="{Binding VacuumButtonText}" Height="38" Padding="14,0" Style="{StaticResource AmberActionButton}" Margin="0,0,6,0" Click="BtnStep2Vacuum_Click"/>
                    <TextBlock Text="➔" VerticalAlignment="Center" Foreground="#94A3B8" FontWeight="Bold" Margin="0,0,6,0"/>
                    <Button Content="③ ▶ 자동 측정 시작 (Start Scan)" Height="38" Padding="16,0" Style="{StaticResource MintActionButton}" Margin="0,0,8,0" Click="BtnStep3Start_Click"/>
                    <Button Content="■ 측정 중지 (Stop)" Height="38" Padding="14,0" Style="{StaticResource CoralActionButton}" Margin="0,0,16,0" Click="BtnStop_Click"/>
                </StackPanel>

                <!-- 우측: 운전 모드 선택(Mode 0~5) 및 진공/로드셀 실시간 배지 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="운전 모드:" VerticalAlignment="Center" FontWeight="Bold" Foreground="#334155" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding OperationModes}" SelectedIndex="{Binding SelectedOperationModeIndex}" Width="290" Height="32" VerticalContentAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>

                    <Border Background="{Binding VacuumBadgeBg}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding VacuumStatusText}" Foreground="{Binding VacuumBadgeFg}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <Border Background="{Binding LoadCellBadgeBg}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,5">
                        <TextBlock Text="{Binding LoadCellStatusText}" Foreground="{Binding LoadCellBadgeFg}" FontWeight="Bold" FontSize="12"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 3. 상단 리본 탭 기반 메인 워크스페이스 -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,6,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontSize" Value="13.5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="18,10"/>
                    <Setter Property="Margin" Value="0,0,6,0"/>
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: 메인 자동 계측 대시보드 (좌: 2D 스테이지 맵 / 우: 실시간 결과 & 식각 비교 & 로그) -->
            <TabItem Header="🏠 1. 메인 자동 계측 (2D 스테이지 맵 &amp; 실시간 데이터)">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="680"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <panels:StageMapControl Grid.Column="0"/>
                    <panels:EtchComparisonControl Grid.Column="2"/>
                </Grid>
            </TabItem>

            <!-- Tab 2: 10x10 마스터 레시피 편집기 & 행/열 미세조정 -->
            <TabItem Header="📐 2. 10×10 레시피 편집 &amp; 행/열 미세조정 (Shift)">
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="560"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <panels:StageMapControl Grid.Column="0"/>
                    <panels:RecipeEditorControl Grid.Column="2"/>
                </Grid>
            </TabItem>

            <!-- Tab 3: H/W & I/O Check (CNT2 / DB32T 16DI-16DO / CI-600A 로드셀 / 3축 JOG) -->
            <TabItem Header="🛠 3. H/W &amp; I/O Check (CNT2 / DIO / CI-600A 로드셀 / JOG)">
                <Grid Margin="0,6,0,0">
                    <panels:IoHardwareCheckControl/>
                </Grid>
            </TabItem>

            <!-- Tab 4: 3종 센서 3D 오프셋 & Z축 다중 정지 우선순위 & 시스템 설정 -->
            <TabItem Header="⚙ 4. 3종 센서 오프셋 &amp; Z축 우선순위 / 통신 설정">
                <Grid Margin="0,6,0,0">
                    <panels:SystemConfigControl/>
                </Grid>
            </TabItem>

            <!-- Tab 5: CL-3000 식각(연마) 전/후 단차 비교 분석 전용 뷰 -->
            <TabItem Header="📉 5. CL-3000 식각(연마) 전/후 단차(ΔH) 정밀 비교">
                <Grid Margin="0,6,0,0">
                    <panels:EtchComparisonControl/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 4. 하단 상태 표시줄 및 진행률 바 -->
        <Border Grid.Row="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,10,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#1E3A8A" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RecipeSummaryText}" Foreground="#475569" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Width="260" Height="16" Foreground="#2563EB" Background="#DBEAFE"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

