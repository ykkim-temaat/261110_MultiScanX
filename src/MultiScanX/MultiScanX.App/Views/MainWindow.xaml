<Window x:Class="MultiScanX.App.Views.MainWindow"
        
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
    xmlns:vm="clr-namespace:MultiScanX.App.ViewModels"
        mc:Ignorable="d"
        Title="MultiScan-X Studio - KCT向 박막두께 자동계측 시스템 (TeMaat)" 
        Height="900" Width="1400" Background="#1E1E1E">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header Title -->
            <RowDefinition Height="Auto"/>
            <!-- Control Bar -->
            <RowDefinition Height="*"/>
            <!-- Main Content (Map & Results) -->
            <RowDefinition Height="Auto"/>
            <!-- Status & Progress Bar -->
        </Grid.RowDefinitions>
        <!-- 1. Header Title & System Mode -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="🔬 MultiScan-X Studio [v1.0.0]" FontSize="18" FontWeight="Bold" Foreground="#4EC9B0" VerticalAlignment="Center"/>
                <TextBlock Text=" | K社(KCT向) 510×515mm 대면적 박막두께 통합 계측 제어기" FontSize="14" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Background="#1E392A" BorderBrush="#107C41" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="🛡 HW EMO: Normal (MC ON)" Foreground="#4EC9B0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <Border Background="#0E639C" CornerRadius="4" Padding="10,4">
                        <TextBlock Text="● Simulation (Dry-Run Mode)" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- 2. Control Toolbar -->
        <Border Grid.Row="1" Background="#2D2D30" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ 자동 계측 시작 (Start Scan)" Width="180" Height="38" Background="#0E639C" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="BtnStart_Click"/>
                <Button Content="■ 측정 중지 (Stop Scan)" Width="150" Height="38" Background="#D83B01" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Click="BtnStopScan_Click"/>
                <Button Content="🔔 챔버 도어 잠금" Width="150" Height="38" Background="#107C41" Foreground="White" FontWeight="Bold" Margin="0,0,20,0" Click="BtnDoorLock_Click"/>
                <Separator Margin="0,0,20,0"/>
                <TextBlock Text="Recipe:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding CurrentRecipe.RecipeName}" Foreground="#4EC9B0" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="기판 규격:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="510 × 515 mm (30 Points)" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="진공 압력:" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="-78.5 kPa (정상)" Foreground="#4EC9B0" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <!-- 3. Main Workspace Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="650"/>
                <!-- Left: 2D Stage Visualizer -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Data Grid & Logs -->
            </Grid.ColumnDefinitions>
            <!-- Left: 2D Stage Visualizer (510 x 515 mm) -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="6" Padding="12" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="🗺 510×515mm 스테이지 2D 매핑 뷰어 (30 Points Grid)" FontWeight="Bold" Foreground="#DDD" Margin="0,0,0,10"/>
                    <Border Background="#1A1A1A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4">
                        <Canvas x:Name="StageCanvas" Width="550" Height="550" Background="#202020">
                            <!-- 510 x 515 mm Substrate Frame -->
                            <Rectangle Canvas.Left="20" Canvas.Top="17" Width="510" Height="515" Stroke="#007ACC" StrokeThickness="2" Fill="#2A2D34" Opacity="0.5"/>
                            <TextBlock Canvas.Left="30" Canvas.Top="25" Text="SUBSTRATE (510 x 515 mm)" Foreground="#569CD6" FontSize="11"/>
                        </Canvas>
                    </Border>
                </DockPanel>
            </Border>
            <!-- Right: Measurement Results Table & Console Log -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*"/>
                    <!-- Measurement Table -->
                    <RowDefinition Height="2*"/>
                    <!-- Log Console -->
                </Grid.RowDefinitions>
                <!-- Top: Measured Points DataGrid -->
                <Border Grid.Row="0" Background="#252526" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📊 실시간 계측 결과 데이터 (MMS Thick Cu / F20 / LoadCell)" FontWeight="Bold" Foreground="#DDD" Margin="0,0,0,6"/>
                        <DataGrid ItemsSource="{Binding MeasuredPoints}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  Background="#1E1E1E" RowBackground="#252526" AlternatingRowBackground="#2A2A2B" 
                                  Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Pt" Binding="{Binding PointId}" Width="40"/>
                                <DataGridTextColumn Header="X (mm)" Binding="{Binding TargetX, StringFormat=F2}" Width="70"/>
                                <DataGridTextColumn Header="Y (mm)" Binding="{Binding TargetY, StringFormat=F2}" Width="70"/>
                                <DataGridTextColumn Header="Z-Scale (mm)" Binding="{Binding ActualZ, StringFormat=F4}" Width="90"/>
                                <DataGridTextColumn Header="Cu (um)" Binding="{Binding CuThicknessUm, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Film (nm)" Binding="{Binding FilmThicknessNm, StringFormat=F1}" Width="80"/>
                                <DataGridTextColumn Header="GOF" Binding="{Binding FilmGoodnessOfFit, StringFormat=F3}" Width="60"/>
                                <DataGridTextColumn Header="Load (g)" Binding="{Binding ContactLoadG, StringFormat=F1}" Width="70"/>
                                <DataGridTextColumn Header="판정" Binding="{Binding Note}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <!-- Bottom: Real-time System Log Console -->
                <Border Grid.Row="1" Background="#252526" CornerRadius="6" Padding="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="📜 시스템 동작 로그 (Operation Log)" FontWeight="Bold" Foreground="#DDD" Margin="0,0,0,6"/>
                        <ListBox ItemsSource="{Binding LogMessages}" Background="#1A1A1A" Foreground="#DCDCDC" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
        <!-- 4. Footer Status & Progress Bar -->
        <Border Grid.Row="3" Background="#007ACC" CornerRadius="4" Padding="10,6">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Width="250" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

