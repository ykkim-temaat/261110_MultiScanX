<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MultiScanX.App</RootNamespace>
    <GuiLayout Condition="'$(GuiLayout)' == ''">Default</GuiLayout>
    <AssemblyName Condition="'$(GuiLayout)' == 'Default'">MultiScanX.App</AssemblyName>
    <AssemblyName Condition="'$(GuiLayout)' == 'A'">MultiScanX_LayoutA_RibbonTab</AssemblyName>
    <AssemblyName Condition="'$(GuiLayout)' == 'B'">MultiScanX_LayoutB_SideDock</AssemblyName>
    <AssemblyName Condition="'$(GuiLayout)' == 'C'">MultiScanX_LayoutC_FloatingStudio</AssemblyName>
    <DefineConstants Condition="'$(GuiLayout)' == 'A'">$(DefineConstants);LAYOUT_A</DefineConstants>
    <DefineConstants Condition="'$(GuiLayout)' == 'B'">$(DefineConstants);LAYOUT_B</DefineConstants>
    <DefineConstants Condition="'$(GuiLayout)' == 'C'">$(DefineConstants);LAYOUT_C</DefineConstants>
    <Version>1.2.0</Version>
    <Description>디자인 C 기반 실물 DIO(DB32T) 50ms 폴링, AI16(16CH) 스케일링 모니터 및 CNT2(Z-Scale) Low-Level 설정 통합</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MultiScanX.Core\MultiScanX.Core.csproj" />
    <ProjectReference Include="..\MultiScanX.Hardware\MultiScanX.Hardware.csproj" />
  </ItemGroup>

</Project>
