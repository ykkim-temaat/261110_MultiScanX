# 프로젝트 로컬 임시 스크립트 및 작업 폴더 격리 (Rule 07)
scratch/

# MS Office / CAD 임시 락 파일 및 백업 파일
~$*.pptx
~$*.xlsx
~$*.docx
*.bak
*.tmp
*.skb

# Python 캐시 및 가상환경
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# OS 및 IDE 메타데이터
.DS_Store
Thumbs.db
Desktop.ini
.vscode/*
!.vscode/settings.json
.idea/

# 민감 정보 및 로컬 환경변수
.env
*.pem
*.key

# 대용량 설치 패키지 및 압축 파일 격리 (Git 50MB~100MB 제한 대응 - Rule 09)
*.zip
*.7z
*.tar.gz
*.iso
*.msi
*.exe


